{
  "manifest_version": 3,
  "name": "GSC Bulk Link Indexer",
  "version": "1.0.0",
  "description": "Automate requesting indexing for multiple URLs in Google Search Console.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://search.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
